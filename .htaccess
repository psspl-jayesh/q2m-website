# Q2M Solutions: redirects for old URLs (301) and the 404 page. Generated by scripts/redirects.mjs; edit the list there.
# Apache: put this file in the web root (next to index.html). Needs mod_rewrite (standard on most hosts).

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Use ONE host name. The site uses https://q2msolutions.in (no www): www is redirected to it.
RewriteCond %{HTTP_HOST} ^www\.q2msolutions\.in$ [NC]
RewriteRule ^(.*)$ https://q2msolutions.in/$1 [R=301,L]

# Old URLs
RewriteRule ^case-study/?$ /case-studies/ [R=301,L]
RewriteRule ^portfolio/?$ /case-studies/ [R=301,L]
RewriteRule ^author/waseem/?$ /blogs/ [R=301,L]
RewriteRule ^category/artificial-intelligence/ai-chatbot-development/?$ /category/ai-chatbot-development/ [R=301,L]
RewriteRule ^category/development/machine-learning-development-service/?$ /category/machine-learning-development-service/ [R=301,L]
RewriteRule ^agentic-ai-services/?$ /ai-agent-development-services/ [R=301,L]
RewriteRule ^recommendation-engines/?$ /ai-recommendation-systems/ [R=301,L]
RewriteRule ^ai4-2026-americas-largest-ai-conference/?$ /q2m-solutions-is-heading-to-ai4-2026/ [R=301,L]
</IfModule>

# Caching: hashed build files and optimised images never change, so they can be cached for a year; pages are always revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
